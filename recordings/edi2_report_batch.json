// ============================================================
// EDI2 検収状況一覧 バッチ定義（ダウンロード）
//  ・行の先頭が // または # の行はコメント（読み飛ばされる）
//  ・{{列名}} は明細 CSV の列に置き換わる
//
// 納入登録バッチの結果 CSV をそのまま明細として読む。
// 変換するときは「前のバッチの結果 CSV を明細にする」にチェックを入れる。
//
// 要求 ID だけでなく発注番号と納入番号も入れる。実サイトでは絞り込みの
// 条件になり、練習サイトではこの値を使って一覧を組み立てる。
//
// 明細 CSV に要る列: プロジェクト番号 / 発注番号 / 要求ID
//   （納入登録バッチの pad_result.csv がそのまま使える）
// ============================================================
{
  "originHint": "検収状況一覧",
  "title": "EDI2 検収状況一覧 — 納入登録で発番された要求 ID で照会し、Excel を保存する",
  "setup": [
    {
      "type": "setViewport",
      "width": 1366,
      "height": 900
    },
    {
      "type": "navigate",
      "url": "file:///C:/temp/index.html"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#PosHpgGenericUrl3c"
        ],
        [
          "text/ホームページ"
        ]
      ]
    }
  ],
  "loop": [
    {
      "type": "comment",
      "text": "要求 {{要求ID}}（{{プロジェクト番号}}）のエビデンスを取得"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/帳票出力"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{要求ID}}",
      "selectors": [
        [
          "#ReqIdField"
        ]
      ]
    },
    {
      "type": "comment",
      "text": "発注番号も入れる。実サイトでは絞り込みの条件になる"
    },
    {
      "type": "change",
      "value": "{{発注番号}}",
      "selectors": [
        [
          "#PoFromField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{プロジェクト番号}}",
      "selectors": [
        [
          "#ShipNoField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{納入日}}",
      "selectors": [
        [
          "#DateFromField"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#ContinueBtn"
        ],
        [
          "text/続行(C)"
        ]
      ]
    },
    {
      "type": "assertText",
      "text": "{{要求ID}}"
    },
    {
      "type": "comment",
      "text": "出力アイコンを押すと Excel が落ちてくる"
    },
    {
      "type": "download",
      "selectors": [
        [
          "#OutputIcon0"
        ],
        [
          "text/出力"
        ]
      ],
      "name": "{{プロジェクト番号}}_XXPO_検収状況一覧_{{要求ID}}"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#PosHpgGenericUrl3c"
        ],
        [
          "text/ホームページ"
        ]
      ]
    }
  ],
  "recover": [
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#PosHpgGenericUrl3c"
        ],
        [
          "text/ホームページ"
        ]
      ]
    }
  ]
}
