// ============================================================
// EDI2 ② 検収状況一覧を発行して要求 ID を記録する
//
// 発注番号と納入日で条件を入れて発行すると、要求 ID がポップアップで出る。
//   「XXPO:検収状況一覧 への要求は予定されました。 要求IDは 131982564 です。」
// capture の extract: digits で数字だけを取り出し、結果 CSV の列に残す。
//
// **発行から出力できるまで 1 分〜3 時間かかる。** ③は時間をおいて実行する。
//
// 明細 CSV に要る列: プロジェクト番号 / 発注番号 / 納入日
// ============================================================
{
  "originHint": "検収状況一覧",
  "title": "EDI2 ② 検収状況一覧を発行して要求 ID を記録する",
  "setup": [
    {
      "type": "setViewport",
      "width": 1366,
      "height": 900
    },
    {
      "type": "navigate",
      "url": "file:///C:/temp/index.html"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ],
  "loop": [
    {
      "type": "comment",
      "text": "発注 {{発注番号}}（{{プロジェクト番号}}）の帳票を発行"
    },
    {
      "type": "change",
      "value": "ALL",
      "selectors": [
        [
          "#StatusField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{発注番号}}",
      "selectors": [
        [
          "#PoFromField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{発注番号}}",
      "selectors": [
        [
          "#PoToField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{納入日}}",
      "selectors": [
        [
          "#DateFromField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{納入日}}",
      "selectors": [
        [
          "#DateToField"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#ContinueBtn"
        ],
        [
          "text/続行(C)"
        ]
      ]
    },
    {
      "type": "comment",
      "text": "レビュー画面。発行を押すと要求 ID がポップアップで出る"
    },
    {
      "type": "comment",
      "text": "レビュー画面の納入日を記録する。③がこの値で中身を作る"
    },
    {
      "type": "capture",
      "selectors": [
        [
          "#ReviewDate"
        ]
      ],
      "name": "納入日"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#PublishBtn"
        ],
        [
          "text/発行"
        ]
      ]
    },
    {
      "type": "assertText",
      "text": "要求IDは"
    },
    {
      "type": "comment",
      "text": "文章から番号だけを取り出して結果 CSV に残す"
    },
    {
      "type": "capture",
      "selectors": [
        [
          "#ReqInfoMsg"
        ]
      ],
      "name": "要求ID",
      "extract": "digits"
    },
    {
      "type": "screenshot",
      "name": "エビデンス"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#OkBtn"
        ],
        [
          "text/OK"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ],
  "recover": [
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ]
}
