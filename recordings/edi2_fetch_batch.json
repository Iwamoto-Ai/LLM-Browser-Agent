// ============================================================
// EDI2 ③ 要求 ID の行から Excel をダウンロードする
//
// ②の結果 CSV をそのまま明細として読む。
// 変換するときは「前のバッチの結果 CSV を明細にする」にチェックを入れる。
//
// 要求要約表には検索欄が無く、目的の行を目で探すしかない。
// row/{{要求ID}} で「その文字を含む行の、最初のリンクやアイコン」を押す。
//
// 明細 CSV に要る列: プロジェクト番号 / 発注番号 / 納入日 / 要求ID
//   （②の pad_result.csv がそのまま使える）
// ============================================================
{
  "originHint": "検収状況一覧",
  "title": "EDI2 ③ 要求 ID の行から Excel をダウンロードする",
  "setup": [
    {
      "type": "setViewport",
      "width": 1366,
      "height": 900
    },
    {
      "type": "navigate",
      "url": "file:///C:/temp/index.html"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ],
  "loop": [
    {
      "type": "comment",
      "text": "要求 {{要求ID}}（{{プロジェクト番号}}）の Excel を取得"
    },
    {
      "type": "comment",
      "text": "練習サイトはサーバーを持たないので、条件を入れて中身を作る"
    },
    {
      "type": "change",
      "value": "{{発注番号}}",
      "selectors": [
        [
          "#PoFromField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{納入日}}",
      "selectors": [
        [
          "#DateFromField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{プロジェクト番号}}",
      "selectors": [
        [
          "#ShipNoField"
        ]
      ]
    },
    {
      "type": "change",
      "value": "{{要求ID}}",
      "selectors": [
        [
          "#ReqIdField"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#ShowReqBtn"
        ],
        [
          "text/要求の表示"
        ]
      ]
    },
    {
      "type": "assertText",
      "text": "{{要求ID}}"
    },
    {
      "type": "comment",
      "text": "要求要約表には検索欄が無い。row/ で目的の行を探す"
    },
    {
      "type": "download",
      "selectors": [
        [
          "row/{{要求ID}}"
        ]
      ],
      "name": "{{プロジェクト番号}}_XXPO_検収状況一覧_{{要求ID}}"
    },
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ],
  "recover": [
    {
      "type": "click",
      "selectors": [
        [
          "#homeIcon"
        ],
        [
          "text/ホーム"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI仕入先"
        ],
        [
          "text/📁 仕入先（練習）"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI取引情報入力・照会"
        ],
        [
          "text/📁 取引情報入力・照会"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI帳票出力"
        ],
        [
          "text/📁 帳票出力"
        ]
      ]
    },
    {
      "type": "click",
      "selectors": [
        [
          "#LI検収状況一覧"
        ],
        [
          "text/検収状況一覧"
        ]
      ]
    }
  ]
}
